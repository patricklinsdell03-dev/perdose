---
// One supplement on the home and browse pages (Patrick, 2026-09-19: every card in the Capsule
// style): the lead form's cheapest UK product drawn as the same Capsule card the price tables
// use — rank capsule, the price per dose biggest, buy capsule — then the other forms' prices
// and how much we compared.
import type { CompoundData } from '../lib/data';
import { compoundSlug, defaultClass, pageClasses, ukRanked } from '../lib/data';
import { doseLabel, formHeading, lowerFirst, perDose } from '../lib/format';
import OfferRow from './OfferRow.astro';

interface Props {
  data: CompoundData;
  /** Heading level for the supplement's name, to fit the page's outline. */
  level?: 2 | 3 | 4;
}

const { data, level = 3 } = Astro.props;
const c = data.compound;
const slug = compoundSlug(c.id);
const priced = pageClasses(data).filter((cls) => ukRanked(cls).length > 0);
const lead = priced.includes(defaultClass(data)) ? defaultClass(data) : priced[0];
const rest = priced.filter((cls) => cls !== lead);
const offers = data.classes.flatMap((k) => [...k.ranked, ...k.combinations, ...k.unverified]);
const products = new Set(offers.map((o) => o.product_id)).size;
const retailers = new Set(offers.map((o) => o.retailer_id)).size;
const leadOffers = lead ? ukRanked(lead) : [];
const best = leadOffers[0];
const Heading = `h${level}` as 'h2' | 'h3' | 'h4';
---

{
  lead && best && (
    <li class="card compound-card">
      <Heading class="card-title">
        <a href={`/c/${slug}/`}>{c.name}</a>
      </Heading>
      <p class="compound-card-note">
        {rest.length ? `${lead.label}: cheapest ${doseLabel(c, lead.standard_dose)}` : `Cheapest ${doseLabel(c, lead.standard_dose)}`}
      </p>
      <div class="offer-list compound-card-offer">
        <table class="offer-table" role="table">
          <caption class="sr-only">The cheapest {lowerFirst(formHeading(c, lead))}</caption>
          <tbody role="rowgroup">
            <OfferRow compound={c} cls={lead} offer={best} rank={1} best open={false} />
          </tbody>
        </table>
      </div>
      <p class="compound-card-more">
        <a href={`/c/${slug}/${lead.slug}/`}>
          See all {leadOffers.length} {rest.length ? lowerFirst(lead.label.replace(/\s*\(.*\)$/, '')) : ''} prices
        </a>
      </p>
      {
        rest.length > 0 && (
          <ul class="forms">
            {rest.map((cls) => (
              <li>
                <a href={`/c/${slug}/${cls.slug}/`}>{cls.label}</a>
                <strong>{perDose(ukRanked(cls)[0].price_per_std_dose)}</strong>
              </li>
            ))}
          </ul>
        )
      }
      <p class="count">
        {products} {products === 1 ? 'product' : 'products'} · {retailers} {retailers === 1 ? 'retailer' : 'retailers'}
      </p>
    </li>
  )
}
