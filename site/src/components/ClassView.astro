---
// Tabs for a compound's classes plus the table for one of them. Used by the compound page
// (default class) and by each class page.
import type { ClassData, CompoundData } from '../lib/data';
import { compoundSlug, pageClasses } from '../lib/data';
import OfferTable from './OfferTable.astro';

interface Props {
  data: CompoundData;
  cls: ClassData;
  /** On the compound page the tabs link away to class pages, so the shown form is only "current". */
  overview?: boolean;
}

const { data, cls, overview = false } = Astro.props;
const base = `/c/${compoundSlug(data.compound.id)}`;
const classes = pageClasses(data);
---

{
  classes.length > 1 && (
    <nav aria-label={`${data.compound.name} forms`}>
      <ul class="tabs" data-tabs>
        {classes.map((item) => (
          <li>
            <a href={`${base}/${item.slug}/`} aria-current={item.id === cls.id ? (overview ? 'true' : 'page') : undefined}>
              {item.label} {item.ranked.length + item.unverified.length > 0 ? `(${item.ranked.length + item.unverified.length})` : '(combinations)'}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<OfferTable compound={data.compound} cls={cls} />

<script>
  // On phones the tabs scroll sideways; bring the current one into view without moving the page.
  for (const list of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const current = list.querySelector<HTMLElement>('[aria-current]');
    if (current && list.scrollWidth > list.clientWidth) {
      list.scrollLeft = current.offsetLeft - list.offsetLeft - (list.clientWidth - current.offsetWidth) / 2;
    }
  }
</script>
