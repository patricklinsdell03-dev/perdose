---
// The ranked table (brief §12.2). Rows are rendered at build time, already sorted by price
// per standard dose, as Capsule cards (OfferRow). The script below only re-sorts, filters and
// re-scales them for "your dose" using the per-unit price computed by the pipeline — it never
// reads a label. Combination products (Phase 8) are rendered too, but hidden until the toggle
// is on, and can never win a "cheapest" badge.
import type { ClassData, CompoundRule } from '../lib/data';
import { isInternational, retailerName, ukRanked } from '../lib/data';
import { amount, doseLabel, isoToLong, money } from '../lib/format';
import OfferRow from './OfferRow.astro';

interface Props {
  compound: CompoundRule;
  cls: ClassData;
}

const { compound, cls } = Astro.props;
const dose = cls.standard_dose;
const unitLabel = amount(1, compound.unit).replace(/^1\s*/, '');
const retailers = [...new Set([...cls.ranked, ...cls.combinations].map((o) => o.retailer_id))];
const latest = [...cls.ranked, ...cls.combinations, ...cls.unverified].map((o) => o.price_date).sort().at(-1);
const SIX_MONTHS = 183;
const uk = ukRanked(cls);
const practical = uk.find((o) => (o.days_supply ?? Infinity) <= SIX_MONTHS);
const cheapest = uk[0];
const international = cls.ranked.filter(isInternational).length;
const combos = cls.combinations.length;
const rows = [
  ...cls.ranked.map((offer) => ({ offer, combo: false })),
  ...cls.combinations.map((offer) => ({ offer, combo: true })),
];
const name = compound.name.toLowerCase();

// What to say when no UK single-ingredient product can be ranked (most often: a form that
// only turns up inside combination products).
const emptyTitle = combos
  ? 'Only combination products for this form'
  : international
    ? 'No UK-based sellers for this form yet'
    : 'Nothing we could verify yet';
const emptyText = combos
  ? `${combos === 1 ? 'The one product here contains' : `The ${combos} products here contain`} ${name} alongside other ingredients, so ${combos === 1 ? 'it is' : 'they are'} not ranked against single-ingredient products. ${combos === 1 ? 'Its' : 'Their'} price per dose counts the ${name} only.`
  : international
    ? `${international === 1 ? 'One seller ships' : `${international} sellers ship`} this form to the UK from abroad. Check delivery times and import charges before buying.`
    : 'Every listing for this form is unverified, so none is ranked. They are listed below with the reason.';
---

<section class="offers" data-offers data-standard-dose={dose} data-uk={uk.length}>
  <p class="table-meta">
    {latest && <>Prices last checked: <time datetime={latest}>{isoToLong(latest)}</time>. </>}
    Ranked purely by price {doseLabel(compound, dose)} — a comparison unit, not a recommendation.
    We may earn commission from these links; it never affects the order.
  </p>

  {
    rows.length > 0 && (
      <>
        {/* A slim bar that stays in view while scrolling the table (mock-up B2's dose bar):
            your dose, then sort and filters folded into one panel. */}
        <form class="toolbar" data-controls data-pagefind-ignore>
          <label class="dose-field">
            <span class="dose-label">Your <span class="wide-only">daily </span>dose</span>
            <span class="dose-input">
              <input type="number" name="dose" min="0" step="any" value={dose} data-dose inputmode="decimal" aria-describedby={`dose-hint-${cls.id}`} />
              {unitLabel}
            </span>
          </label>
          <label class="period-field">
            <span class="dose-label">Show price</span>
            <select name="per" data-period>
              <option value="dose">Per dose</option>
              <option value="week">Per week</option>
              <option value="month">Per month</option>
              <option value="year">Per year</option>
            </select>
          </label>
          <p class="dose-hint" id={`dose-hint-${cls.id}`}>
            Compared at {dose.toLocaleString('en-GB')} {unitLabel}. Enter the amount you take to see your own costs.
          </p>
          <details class="filters" data-filters>
            <summary>
              <span class="wide-only">Sort and filter</span><span class="narrow-only">Filters</span>
              <span class="filter-count" data-filter-count hidden></span>
            </summary>
            <div class="filters-panel">
              <label class="sort-field">
                Sort by
                <select name="sort" data-sort>
                  <option value="dose">Price per dose</option>
                  <option value="month">Cost per month</option>
                  <option value="pack">Pack price</option>
                  <option value="days">Days' supply (longest first)</option>
                </select>
              </label>
              {retailers.length > 1 && (
                <fieldset>
                  <legend>Retailers</legend>
                  {retailers.map((id) => (
                    <label class="check">
                      <input type="checkbox" name="retailer" value={id} checked data-retailer-filter /> {retailerName(id)}
                    </label>
                  ))}
                </fieldset>
              )}
              <fieldset>
                <legend>Show</legend>
                <label class="check"><input type="checkbox" data-filter="stock" /> In stock only</label>
                <label class="check"><input type="checkbox" data-filter="tested" /> Testing claim on label</label>
                {combos > 0 && (
                  <label class="check">
                    <input type="checkbox" data-filter="combos" /> Include combination products ({combos})
                  </label>
                )}
                {international > 0 && (
                  <label class="check">
                    <input type="checkbox" data-filter="intl" /> Include sellers shipping from outside the UK ({international})
                  </label>
                )}
              </fieldset>
              <button type="button" class="button-plain" data-clear>Clear sort and filters</button>
            </div>
          </details>
        </form>

        <div class="offer-list" data-table hidden={uk.length === 0}>
          <table class="offer-table" role="table">
            <caption class="sr-only">{compound.name}, {cls.label}: products ranked by price {doseLabel(compound, dose)}</caption>
            <thead role="rowgroup">
              <tr role="row">
                <th role="columnheader" scope="col">Rank</th>
                <th role="columnheader" scope="col">Product</th>
                <th role="columnheader" scope="col" data-dose-heading>{doseLabel(compound, dose).replace(/^per/, 'Per')}</th>
                <th role="columnheader" scope="col">Per month</th>
                <th role="columnheader" scope="col">Lasts</th>
                <th role="columnheader" scope="col">Buy</th>
                <th role="columnheader" scope="col">How it is worked out</th>
              </tr>
            </thead>
            <tbody role="rowgroup" data-rows>
              {rows.map(({ offer, combo }, index) => (
                <OfferRow
                  compound={compound}
                  cls={cls}
                  offer={offer}
                  rank={combo ? '+' : index + 1}
                  combo={combo}
                  best={offer === cheapest}
                  practical={offer === practical && offer !== cheapest}
                  hidden={combo || isInternational(offer)}
                />
              ))}
            </tbody>
          </table>
        </div>
        <div class="empty-state" data-empty hidden={uk.length > 0}>
          <h3 data-empty-title>{emptyTitle}</h3>
          <p data-empty-text>{emptyText}</p>
          {(combos > 0 || international > 0) && (
            <p class="empty-actions">
              {combos > 0 && (
                <button type="button" class="pill-button" data-show="combos" hidden>
                  Show {combos === 1 ? 'the combination product' : `the ${combos} combination products`}
                </button>
              )}
              {international > 0 && (
                <button type="button" class="pill-button" data-show="intl" hidden>
                  Show sellers shipping from abroad ({international})
                </button>
              )}
            </p>
          )}
        </div>
      </>
    )
  }

  {
    cls.unverified.length > 0 && (
      <section class="unverified">
        <h3>Unverified ({cls.unverified.length})</h3>
        <p>
          We could not confirm the amounts for these from the retailer's listing, so they are <strong>not ranked</strong>.
          <a href="/methodology/#unverified">What “unverified” means</a>.
        </p>
        <ul>
          {cls.unverified.map((offer) => (
            <li>
              <a href={`/p/${offer.product_id}/`}>{offer.display_name}</a> — {money(offer.price_gbp)} at {retailerName(offer.retailer_id)}
              <span class="badge warn">Unverified</span>
              <br />
              <small>{offer.review_reasons.map((r) => r.text).join(' ')}</small>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</section>

<script>
  // "Your dose", sorting, filters and the combinations toggle (brief §12.2). State lives in
  // the URL (?dose=400&combos=1) so a view can be shared; nothing is stored. Prices scale
  // from the pipeline's per-unit price.
  const SIX_MONTHS = 183;

  function perDose(value: number): string {
    const decimals = Math.min(4, Math.max(2, 2 - Math.floor(Math.log10(value))));
    return `£${value.toFixed(decimals)}`;
  }

  function days(value: number): string {
    if (value >= 365) return `${Math.round((value / 365) * 10) / 10} years`;
    if (value >= 60) return `${Math.round(value / 30.4)} months`;
    return `${Math.round(value)} days`;
  }

  for (const section of document.querySelectorAll<HTMLElement>('[data-offers]')) {
    const body = section.querySelector<HTMLElement>('[data-rows]');
    const doseInput = section.querySelector<HTMLInputElement>('[data-dose]');
    const sortSelect = section.querySelector<HTMLSelectElement>('[data-sort]');
    const periodSelect = section.querySelector<HTMLSelectElement>('[data-period]');
    if (!body || !doseInput || !sortSelect) continue;

    const standardDose = Number(section.dataset.standardDose);
    const ukCount = Number(section.dataset.uk);
    const rows = [...body.querySelectorAll<HTMLElement>('[data-row]')];
    const filter = (name: string) => section.querySelector<HTMLInputElement>(`[data-filter="${name}"]`);
    const empty = section.querySelector<HTMLElement>('[data-empty]');
    const emptyTitle = empty?.querySelector<HTMLElement>('[data-empty-title]');
    const emptyText = empty?.querySelector<HTMLElement>('[data-empty-text]');
    const emptyDefault = { title: emptyTitle?.textContent ?? '', text: emptyText?.textContent ?? '' };
    const showButtons = [...section.querySelectorAll<HTMLButtonElement>('[data-show]')];
    const retailerBoxes = [...section.querySelectorAll<HTMLInputElement>('[data-retailer-filter]')];
    const filtersPanel = section.querySelector<HTMLDetailsElement>('details[data-filters]');
    const filterCount = section.querySelector<HTMLElement>('[data-filter-count]');

    // The cheapest row shows its working open. The panel follows the cheapest row as the
    // ranking changes — until the visitor opens or closes one themselves.
    let visitorToggled = false;
    for (const details of section.querySelectorAll<HTMLDetailsElement>('details[data-working]')) {
      details.addEventListener('toggle', () => {
        if (details.dataset.auto) delete details.dataset.auto;
        else visitorToggled = true;
      });
    }

    const params = new URLSearchParams(location.search);
    const fromUrl = Number(params.get('dose'));
    if (fromUrl > 0) doseInput.value = String(fromUrl);
    if (params.get('sort')) sortSelect.value = params.get('sort') ?? 'dose';
    // The main figure can be the cost per week, month or year at your daily dose (?per=month).
    const PERIODS: Record<string, { days: number; label: string }> = {
      week: { days: 7, label: 'Per week' },
      month: { days: 30, label: 'Per month' },
      year: { days: 365, label: 'Per year' },
    };
    if (periodSelect && PERIODS[params.get('per') ?? '']) periodSelect.value = params.get('per') ?? 'dose';
    const combosBox = filter('combos');
    if (combosBox && params.get('combos') === '1') combosBox.checked = true;
    const intlBox = filter('intl');
    if (intlBox && params.get('intl') === '1') intlBox.checked = true;
    // Home page's quick-compare (brief v1.9) sets these too: ?r=bulk,myprotein&stock=1&tested=1
    const wantedRetailers = params.get('r')?.split(',').filter(Boolean);
    if (wantedRetailers?.length) {
      for (const box of section.querySelectorAll<HTMLInputElement>('[data-retailer-filter]')) {
        box.checked = wantedRetailers.includes(box.value);
      }
    }
    if (params.get('stock') === '1' && filter('stock')) filter('stock')!.checked = true;
    if (params.get('tested') === '1' && filter('tested')) filter('tested')!.checked = true;

    const update = () => {
      const dose = Number(doseInput.value) > 0 ? Number(doseInput.value) : standardDose;
      const retailers = new Set(
        [...section.querySelectorAll<HTMLInputElement>('[data-retailer-filter]:checked')].map((i) => i.value),
      );
      const hasRetailerFilter = section.querySelector('[data-retailer-filter]') !== null;
      const onlyStock = filter('stock')?.checked;
      const onlyTested = filter('tested')?.checked;
      const showCombos = combosBox?.checked ?? false;
      const showIntl = intlBox?.checked ?? false;

      const scored = rows.map((row) => {
        const perUnit = Number(row.dataset.ppu);
        const total = Number(row.dataset.total);
        const combo = row.dataset.combo === '1';
        const intl = row.dataset.intl === '1';
        const value = { row, combo, dose: perUnit * dose, days: total / dose, pack: Number(row.dataset.price) };
        const doseCell = row.querySelector<HTMLElement>('[data-cell="dose"]')!;
        const monthCell = row.querySelector<HTMLElement>('[data-cell="month"]')!;
        doseCell.dataset.standardLabel ??= doseCell.dataset.label ?? '';
        const doseText = perDose(value.dose);
        const doseLabelText = dose === standardDose ? doseCell.dataset.standardLabel : 'Per your dose';
        const period = PERIODS[periodSelect?.value ?? 'dose'];
        if (period) {
          // Main tile: cost over the period at this daily dose; second tile: the per-dose price
          // (or per month, when the main tile already shows something else).
          doseCell.textContent = `£${(value.dose * period.days).toFixed(2)}`;
          doseCell.dataset.label = period.label;
          if (period.days === 30) {
            monthCell.textContent = doseText;
            monthCell.dataset.label = doseLabelText;
          } else {
            monthCell.textContent = `£${(value.dose * 30).toFixed(2)}`;
            monthCell.dataset.label = 'Per month';
          }
        } else {
          doseCell.textContent = doseText;
          doseCell.dataset.label = doseLabelText;
          monthCell.textContent = `£${(value.dose * 30).toFixed(2)}`;
          monthCell.dataset.label = 'Per month';
        }
        row.querySelector('[data-cell="days"]')!.textContent = days(value.days);
        const visible =
          (!combo || showCombos) &&
          (!intl || showIntl) &&
          (!hasRetailerFilter || retailers.has(row.dataset.retailer ?? '')) &&
          (!onlyStock || row.dataset.stock === '1') &&
          (!onlyTested || row.dataset.tested === '1');
        row.hidden = !visible;
        return { ...value, visible };
      });

      const order = { dose: 1, month: 1, pack: 1, days: -1 }[sortSelect.value] ?? 1;
      const key = sortSelect.value === 'pack' ? 'pack' : sortSelect.value === 'days' ? 'days' : 'dose';
      scored.sort((a, b) => (a[key] - b[key]) * order);
      let position = 0;
      for (const item of scored) {
        const rank = item.row.querySelector('[data-rank]');
        if (rank && item.visible && !item.combo) rank.textContent = String(++position);
        body.append(item.row);
      }

      // Picks only ever go to single-ingredient products. The cheapest is often a two-year
      // tub, so a second pick marks the best value under six months' supply.
      const eligible = scored.filter((s) => s.visible && !s.combo).sort((a, b) => a.dose - b.dose);
      const cheapest = eligible[0]?.row;
      const practical = eligible.find((s) => s.days <= SIX_MONTHS)?.row;
      for (const row of rows) {
        row.classList.toggle('is-best', row === cheapest);
        row.querySelector<HTMLElement>('[data-badge="cheapest"]')!.hidden = row !== cheapest;
        row.querySelector<HTMLElement>('[data-badge="practical"]')!.hidden = row !== practical || row === cheapest;
        const details = row.querySelector<HTMLDetailsElement>('details[data-working]');
        const open = row === cheapest;
        if (!visitorToggled && details && details.open !== open) {
          details.dataset.auto = '1';
          details.open = open;
        }
      }

      const anyVisible = scored.some((s) => s.visible);
      section.querySelector<HTMLElement>('[data-table]')!.hidden = !anyVisible;
      if (empty) {
        // With no single-ingredient UK product, the default message explains why; otherwise
        // the filters emptied the list.
        const filtered = ukCount > 0 || showCombos || showIntl;
        empty.hidden = anyVisible;
        if (emptyTitle) emptyTitle.textContent = filtered ? 'No products match these filters' : emptyDefault.title;
        if (emptyText) {
          emptyText.textContent = filtered
            ? 'Open “Sort and filter” to tick more retailers or untick an option — or clear them all.'
            : emptyDefault.text;
        }
        for (const button of showButtons) button.hidden = filtered;
      }

      // How many sort/filter settings differ from the defaults, shown on the folded panel.
      const changed = [
        retailerBoxes.some((b) => !b.checked),
        onlyStock,
        onlyTested,
        showCombos,
        showIntl,
        sortSelect.value !== 'dose',
      ].filter(Boolean).length;
      if (filterCount) {
        filterCount.textContent = String(changed);
        filterCount.hidden = changed === 0;
      }

      const heading = section.querySelector<HTMLElement>('[data-dose-heading]');
      const chosen = PERIODS[periodSelect?.value ?? 'dose'];
      if (heading) {
        heading.dataset.standard ??= heading.textContent ?? '';
        heading.textContent = chosen ? chosen.label : dose === standardDose ? heading.dataset.standard : 'Per your dose';
      }
      const monthHeading = heading?.nextElementSibling as HTMLElement | null;
      if (monthHeading) {
        monthHeading.textContent =
          chosen?.days === 30 ? (dose === standardDose ? heading!.dataset.standard ?? '' : 'Per your dose') : 'Per month';
      }

      const next = new URLSearchParams(location.search);
      dose === standardDose ? next.delete('dose') : next.set('dose', String(dose));
      sortSelect.value === 'dose' ? next.delete('sort') : next.set('sort', sortSelect.value);
      chosen ? next.set('per', periodSelect!.value) : next.delete('per');
      showCombos ? next.set('combos', '1') : next.delete('combos');
      showIntl ? next.set('intl', '1') : next.delete('intl');
      const allChecked = retailerBoxes.every((b) => b.checked);
      allChecked || !retailerBoxes.length
        ? next.delete('r')
        : next.set('r', retailerBoxes.filter((b) => b.checked).map((b) => b.value).join(','));
      onlyStock ? next.set('stock', '1') : next.delete('stock');
      onlyTested ? next.set('tested', '1') : next.delete('tested');
      const query = next.toString();
      history.replaceState(null, '', query ? `?${query}` : location.pathname);
    };

    // The empty-state buttons tick the matching filter for the visitor.
    for (const button of showButtons) {
      button.hidden = ukCount > 0;
      button.addEventListener('click', () => {
        const box = filter(button.dataset.show ?? '');
        if (!box) return;
        box.checked = true;
        update();
      });
    }

    section.querySelector('[data-clear]')?.addEventListener('click', () => {
      for (const box of retailerBoxes) box.checked = true;
      for (const name of ['stock', 'tested', 'combos', 'intl']) {
        const box = filter(name);
        if (box) box.checked = false;
      }
      sortSelect.value = 'dose';
      update();
    });

    // The folded panel closes with Escape or a click elsewhere, like any menu.
    if (filtersPanel) {
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && filtersPanel.open) {
          filtersPanel.open = false;
          filtersPanel.querySelector('summary')?.focus();
        }
      });
      document.addEventListener('click', (event) => {
        if (filtersPanel.open && !filtersPanel.contains(event.target as Node)) filtersPanel.open = false;
      });
    }

    section.querySelector('[data-controls]')?.addEventListener('input', update);
    section.querySelector('[data-controls]')?.addEventListener('submit', (event) => event.preventDefault());
    if (fromUrl > 0 || params.get('per') || params.get('sort') || combosBox?.checked || intlBox?.checked || wantedRetailers?.length || params.get('stock') || params.get('tested')) update();
  }
</script>
