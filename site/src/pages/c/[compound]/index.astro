---
import ClassView from '../../../components/ClassView.astro';
import CompoundExplainer from '../../../components/CompoundExplainer.astro';
import FromTile from '../../../components/FromTile.astro';
import Base from '../../../layouts/Base.astro';
import type { CompoundData } from '../../../lib/data';
import { CATEGORY_LABELS, compoundSlug, compounds, defaultClass, retailerName, ukRanked } from '../../../lib/data';
import { doseLabel, formHeading, lowerFirst, money, monthYear, perDose } from '../../../lib/format';
import { learnPages } from '../../../lib/learn';

export function getStaticPaths() {
  // Pages with no products are never built (brief §12.5).
  return compounds
    .filter((data) => defaultClass(data))
    .map((data) => ({ params: { compound: compoundSlug(data.compound.id) }, props: { data } }));
}

interface Props {
  data: CompoundData;
}

const { data } = Astro.props;
const c = data.compound;
const cls = defaultClass(data);
const per = doseLabel(c, c.standard_dose);
const unknown = data.classes.find((k) => k.id === 'unknown');
const ranked = data.classes.flatMap((k) => k.ranked);
const retailerCount = new Set(ranked.map((o) => o.retailer_id)).size;
const ukRetailers = new Set(data.classes.flatMap((k) => ukRanked(k)).map((o) => o.retailer_id)).size;
const title = `Cheapest ${c.name} in the UK — price ${per} (${monthYear(data.generated_at)})`;
const description = ukRanked(cls).length
  ? `${c.name} from ${perDose(ukRanked(cls)[0].price_per_std_dose)} ${doseLabel(c, cls.standard_dose)} across ${retailerCount} retailers, ${ranked.length} products. Compared form by form.`
  : `${c.name} prices compared form by form.`;
// The approved learn page's 100-120-word excerpt, if there is one (brief §12.1).
const glance = (await learnPages()).get(c.id)?.data.at_a_glance;
---

<Base title={title} description={description} image={`/og/${compoundSlug(c.id)}/${cls.slug}.png`} searchTerms={c.aliases} searchWeight={4} searchKind="Compare">
  <header class="page-hero">
    <div>
      <p class="breadcrumb">
        <a href="/">Home</a> › <a href={`/browse/${c.category}/`}>{CATEGORY_LABELS[c.category]}</a>
      </p>
      <h1>{c.name}</h1>
      <span hidden data-pagefind-meta="title[data-v]" data-v={`${c.name}: price ${per}`}></span>
      <p class="page-sub">
        {
          ukRetailers > 0 ? (
            <>
              What it <em>really</em> costs {per}, form by form, across {ukRetailers} UK {ukRetailers === 1 ? 'retailer' : 'retailers'}. A
              unit for comparing, not advice.
            </>
          ) : (
            <>Priced {per}, form by form. So far {lowerFirst(c.name)} only turns up in combination products.</>
          )
        }
      </p>
    </div>
    <FromTile compound={c} cls={cls} />
  </header>

  <h2 class="form-heading">{formHeading(c, cls)}</h2>
  <ClassView data={data} cls={cls} overview />

  {
    unknown && unknown.unverified.length > 0 && (
      <section class="unverified">
        <h3>Form not stated ({unknown.unverified.length})</h3>
        <p>These listings do not say which form they contain, so they cannot be placed in a table.</p>
        <ul>
          {unknown.unverified.map((offer) => (
            <li>
              <a href={`/p/${offer.product_id}/`}>{offer.display_name}</a> — {money(offer.price_gbp)} at {retailerName(offer.retailer_id)}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    glance && (
      <aside class="at-a-glance prose" aria-labelledby="glance-title">
        <h2 id="glance-title">{c.name} at a glance</h2>
        <p>{glance}</p>
        <p><a href={`/learn/${compoundSlug(c.id)}/`}>Read the overview: forms and what the research says</a></p>
      </aside>
    )
  }

  <section class="how">
    <h2>How we work out these prices</h2>
    <CompoundExplainer data={data} cls={cls} />
  </section>

  <CompoundExplainer data={data} cls={cls} faq />
</Base>
