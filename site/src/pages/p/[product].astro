---
// Product detail (brief §12.1 Flow B): label facts, then each ingredient's price per dose at
// every retailer, drawn as the same Capsule cards as the tables, with the working.
import OfferRow from '../../components/OfferRow.astro';
import Base from '../../layouts/Base.astro';
import type { Offer, ProductView } from '../../lib/data';
import { compoundSlug, products, retailerName } from '../../lib/data';
import { BASIS_TEXT, doseLabel, isoToLong, money, pack, perDose, perServing } from '../../lib/format';
import { site } from '../../lib/site';

export function getStaticPaths() {
  return products().map((product) => ({ params: { product: product.id }, props: { product } }));
}

interface Props {
  product: ProductView;
}

const { product } = Astro.props;
const first = product.actives[0].offers[0];
const allOffers = product.actives[0].offers;
const verified = product.actives.some((a) => a.status !== 'unverified');
const cheapest = [...allOffers].sort((a, b) => a.price_gbp - b.price_gbp)[0];
const absolute = (p: string) => (site.base_url ? new URL(p, site.base_url).href : p);
// Cheapest per dose first; offers we could not price go last.
const byDose = (offers: Offer[]) =>
  [...offers].sort((a, b) => (a.price_per_std_dose ?? Infinity) - (b.price_per_std_dose ?? Infinity) || a.price_gbp - b.price_gbp);
const lead = product.actives.find((a) => a.status !== 'unverified');
const leadBest = lead ? byDose(lead.offers)[0] : undefined;

// schema.org Product + Offer only where the data is complete (brief §12.5). No ratings.
const jsonLd = verified
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      ...(product.brand ? { brand: { '@type': 'Brand', name: product.brand } } : {}),
      ...(product.image_url ? { image: product.image_url } : {}),
      url: absolute(`/p/${product.id}/`),
      offers: allOffers.map((offer) => ({
        '@type': 'Offer',
        price: offer.price_gbp.toFixed(2),
        priceCurrency: 'GBP',
        availability: `https://schema.org/${offer.in_stock ? 'InStock' : 'OutOfStock'}`,
        seller: { '@type': 'Organization', name: retailerName(offer.retailer_id) },
        url: offer.url,
      })),
    }
  : undefined;

const report = `mailto:${site.contact_email}?subject=${encodeURIComponent(`Error report: ${product.id}`)}&body=${encodeURIComponent(`Product: ${product.name}\nProduct id: ${product.id}\nWhat looks wrong:\n`)}`;
---

<Base
  title={`${product.name} — price per dose`}
  description={`${product.name}: ${money(cheapest.price_gbp)} at ${retailerName(cheapest.retailer_id)}. Price per standard dose and how we worked it out.`}
  jsonLd={jsonLd}
  searchWeight={0.3}
  searchKind="Product"
  searchSummary={`${product.brand ? `${product.brand} · ` : ''}${money(cheapest.price_gbp)} at ${retailerName(cheapest.retailer_id)}`}
>
  <header class="page-hero">
    <div>
      <p class="breadcrumb">
        <a href="/">Home</a> ›{' '}
        <a href={`/c/${compoundSlug(product.actives[0].data.compound.id)}/`}>{product.actives[0].data.compound.name}</a>
      </p>
      <h1 data-pagefind-meta="title">{product.name}</h1>
      <p class="page-sub">{[product.brand, pack(first)].filter(Boolean).join(' · ')}</p>
    </div>
    {
      lead && leadBest && leadBest.price_per_std_dose !== null && (
        <aside class="from-tile" aria-label="Price per dose">
          <span class="from-label">
            {product.actives.length > 1 ? `${lead.data.compound.name}, ` : 'Price '}
            {doseLabel(lead.data.compound, lead.cls.standard_dose)}
          </span>
          <span class="from-figure">{perDose(leadBest.price_per_std_dose)}</span>
          <span class="from-what">at {retailerName(leadBest.retailer_id)}</span>
        </aside>
      )
    }
  </header>

  {
    !verified && (
      <p class="unverified">
        <strong>Unverified.</strong> We could not confirm this product's amounts from the retailer's listing, so it is not
        ranked. {first.review_reasons.map((r) => r.text).join(' ')}
      </p>
    )
  }
  {
    product.actives.some((a) => a.status === 'combination') && (
      <p class="muted">
        This product contains more than one active ingredient, so it is not ranked against single-ingredient products. Each
        price below counts one ingredient only.
      </p>
    )
  }

  <h2>Label facts</h2>
  <dl class="fact-tiles">
    <div>
      <dt>Pack</dt>
      <dd>{pack(first)}</dd>
    </div>
    {
      first.pack.units_per_serving && (
        <div>
          <dt>Serving</dt>
          <dd>
            {first.pack.units_per_serving}{' '}
            {first.pack.unit_type === 'gram' ? 'g' : first.pack.unit_type === 'ml' ? 'ml' : `${first.pack.unit_type}(s)`}
          </dd>
        </div>
      )
    }
    {
      product.actives.map((a) => (
        <div>
          <dt>
            {a.data.compound.name}
            {a.cls.id !== 'unknown' && <> · {a.cls.label}</>}
          </dt>
          <dd>
            {perServing(a.offers[0])} per serving <span class="basis">({BASIS_TEXT[a.offers[0].amount_basis] ?? a.offers[0].amount_basis})</span>
          </dd>
        </div>
      ))
    }
    {
      first.claimed.length > 0 && (
        <div>
          <dt>Claimed on the listing</dt>
          <dd>{first.claimed.join(', ')}</dd>
        </div>
      )
    }
    {
      first.tested_flag && (
        <div>
          <dt>Testing</dt>
          <dd>Claimed on the label (not verified by us)</dd>
        </div>
      )
    }
  </dl>

  {
    product.actives.map((a) => (
      <section class="product-prices">
        <h2>
          {product.actives.length > 1 ? `${a.data.compound.name}: price` : 'Price'} {doseLabel(a.data.compound, a.cls.standard_dose)}
        </h2>
        <p class="table-meta">
          Prices checked {isoToLong(a.offers.map((o) => o.price_date).sort().at(-1) ?? first.price_date)}.
          {a.cls.id !== 'unknown' && (
            <>
              {' '}
              <a href={`/c/${compoundSlug(a.data.compound.id)}/${a.cls.slug}/`}>Compare every {a.data.compound.name.toLowerCase()} product in this form</a>
            </>
          )}
        </p>
        <div class="offer-list">
          <table class="offer-table" role="table">
            <caption class="sr-only">
              {product.name}: price {doseLabel(a.data.compound, a.cls.standard_dose)} at each retailer
            </caption>
            <tbody role="rowgroup">
              {byDose(a.offers).map((offer, index) => (
                <OfferRow
                  compound={a.data.compound}
                  cls={a.cls}
                  offer={offer}
                  rank={a.status === 'ranked' ? index + 1 : a.status === 'combination' ? '+' : '–'}
                  combo={a.status === 'combination'}
                  best={a.status === 'ranked' && index === 0 && a.offers.length > 1}
                  open={index === 0}
                />
              ))}
            </tbody>
          </table>
        </div>
        {a.status === 'unverified' && (
          <p class="muted">Not ranked for {a.data.compound.name.toLowerCase()}: {a.offers[0].review_reasons.map((r) => r.text).join(' ')}</p>
        )}
      </section>
    ))
  }

  <p class="muted">
    The standard dose is a comparison unit, not a recommendation. Always confirm the price on the retailer's site.
    {site.contact_email && <> <a href={report}>Report an error with this product</a>.</>}
  </p>
</Base>
