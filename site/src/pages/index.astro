---
import CompoundCard from '../components/CompoundCard.astro';
import Base from '../layouts/Base.astro';
import { CATEGORY_LABELS, compoundSlug, compounds, meta, pageClasses, ukRanked } from '../lib/data';
import { amount, doseLabel, isoToLong } from '../lib/format';

// Quick compare (brief v1.9): pick supplement → form → dose → retailers, land on the table filtered.
const quick = compounds
  .map((d) => ({
    id: d.compound.id,
    slug: compoundSlug(d.compound.id),
    name: d.compound.name,
    unit: amount(1, d.compound.unit).replace(/^1\s*/, ''),
    classes: pageClasses(d)
      .filter((cls) => ukRanked(cls).length > 0)
      .map((cls) => ({ slug: cls.slug, label: cls.label, dose: cls.standard_dose })),
  }))
  .filter((c) => c.classes.length > 0)
  .sort((a, b) => a.name.localeCompare(b.name));

// Supplements grouped by ingredient class, in the brief's order (never by health goal, §12.1).
// Those found so far only in combination products are listed by name under their group.
const order = Object.keys(CATEGORY_LABELS);
const groups = [...new Set(compounds.map((d) => d.compound.category))]
  .sort((a, b) => (order.indexOf(a) + 1 || 99) - (order.indexOf(b) + 1 || 99))
  .map((id) => {
    const members = compounds.filter((d) => d.compound.category === id);
    const priced = members.filter((d) => pageClasses(d).some((cls) => ukRanked(cls).length > 0));
    const comboOnly = members.filter((d) => !priced.includes(d) && pageClasses(d).length > 0);
    return { id, label: CATEGORY_LABELS[id] ?? id, priced, comboOnly };
  })
  .filter((group) => group.priced.length + group.comboOnly.length > 0);
const ukRetailers = meta.retailers.filter((r) => r.ships_from === 'GB');
---

<Base>
  <section class="home-hero">
    <div class="home-intro">
      <h1>What supplements <em>really</em> cost, per dose.</h1>
      <p class="lede">
        Tubs, servings and labels are all different, so shelf prices tell you very little. We work out the price of the
        same dose of every product, form by form, and rank them. No one can pay to be higher.
      </p>
      <div id="search" class="hero-search" data-pagefind-ignore>
        <form class="search-box" role="search" aria-label="Search this site" id="search-form">
          <input
            id="search-input"
            type="search"
            name="q"
            autocomplete="off"
            placeholder="Search magnesium, vitamin D, fish oil…"
            aria-label="Search supplements and products"
          />
          <button type="reset" id="search-clear" hidden>Clear</button>
        </form>
        <p class="search-status" id="search-status" role="status" aria-live="polite">
          <noscript>Search needs JavaScript. Browse below, or use the <a href="/a-z/">A–Z</a>.</noscript>
        </p>
        <ul class="search-results" id="search-results"></ul>
      </div>
    </div>

    <!-- Quick compare needs JavaScript (the form list depends on the supplement), so it stays
         hidden until the script runs; without it, the cards below and the A–Z still work. -->
    <form class="quick" data-quick data-quick-choices={JSON.stringify(quick)} hidden>
      <div class="quick-row">
        <label>
          Supplement
          <select name="compound" data-q-compound required>
            <option value="">Choose…</option>
            {quick.map((c) => <option value={c.id}>{c.name}</option>)}
          </select>
        </label>
        <label>
          Form
          <select name="cls" data-q-class></select>
        </label>
        <label>
          Your daily dose
          <span class="dose-wrap"><input type="number" name="dose" min="0" step="any" inputmode="decimal" data-q-dose /> <span data-q-unit></span></span>
        </label>
        <label>
          Show price
          <select name="per" data-per>
            <option value="dose">Per dose</option>
            <option value="week">Per week</option>
            <option value="month">Per month</option>
            <option value="year">Per year</option>
          </select>
        </label>
        <button type="submit" class="pill-button quick-go">Compare prices</button>
      </div>
      <details class="quick-more">
        <summary>More options: retailers, stock, sellers abroad</summary>
        <fieldset>
          <legend class="sr-only">Retailers and options</legend>
          {meta.retailers.map((r) => (
            <label class="check"><input type="checkbox" name="r" value={r.id} checked data-q-retailer /> {r.name}</label>
          ))}
          <label class="check"><input type="checkbox" name="stock" value="1" data-q-stock /> In stock only</label>
          <label class="check"><input type="checkbox" name="intl" value="1" data-q-intl /> Include sellers shipping from outside the UK</label>
        </fieldset>
      </details>
    </form>

    <p class="facts">
      <span><strong>{meta.counts.products}</strong> products</span>
      <span><strong>{ukRetailers.length}</strong> UK retailers: {ukRetailers.map((r) => r.name).join(', ')}</span>
      <span>Prices checked {isoToLong(meta.generated_at)}</span>
    </p>

  </section>

  <h2 class="home-compare">Compare prices</h2>
  {
    groups.map((group) => (
      <section class="home-group" aria-labelledby={`group-${group.id}`}>
        <h3 id={`group-${group.id}`}>
          <a href={`/browse/${group.id}/`}>{group.label}</a>
        </h3>
        {group.priced.length > 0 && (
          <ul class="cards">
            {group.priced.map((data) => <CompoundCard data={data} level={4} />)}
          </ul>
        )}
        {group.comboOnly.length > 0 && (
          <p class="also">
            Also compared, so far only in combination products:{' '}
            {group.comboOnly.map((data, i) => (
              <>
                <a href={`/c/${compoundSlug(data.compound.id)}/`}>{data.compound.name}</a>
                {i < group.comboOnly.length - 1 ? ', ' : '.'}
              </>
            ))}
          </p>
        )}
      </section>
    ))
  }
</Base>

<script is:inline type="module">
  // Plain inline module: Vite must not touch the import of Pagefind's own bundle.
  // Pagefind builds the index after `astro build`; in `astro dev` it does not exist, so
  // search says so instead of failing. Results are our own markup: kind, title, one factual line.
  const GROUPS = [
    ['Compare', 'Price comparisons', 6],
    ['Product', 'Products', 8],
    ['Guide', 'About this site', 3],
  ];
  const form = document.getElementById('search-form');
  const input = document.getElementById('search-input');
  const clear = document.getElementById('search-clear');
  const status = document.getElementById('search-status');
  const list = document.getElementById('search-results');
  let engine;

  async function load() {
    if (engine === undefined) {
      try {
        const path = '/pagefind/pagefind.js';
        engine = await import(path);
        await engine.init();
      } catch {
        engine = null;
      }
    }
    return engine;
  }

  function render(hits, total, query) {
    if (!list || !status) return;
    list.replaceChildren();
    status.textContent = total
      ? `${total} ${total === 1 ? 'result' : 'results'} for “${query}”`
      : `Nothing found for “${query}”. Try the A–Z below the search.`;
    for (const [kind, label, limit] of GROUPS) {
      // A supplement's overview page goes above its form-by-form pages.
      const overview = (hit) => (/^\/c\/[^/]+\/$/.test(hit.url) ? 0 : 1);
      const group = hits
        .filter((hit) => (hit.meta.kind ?? 'Guide') === kind)
        .sort((x, y) => overview(x) - overview(y))
        .slice(0, limit);
      if (!group.length) continue;
      const heading = document.createElement('li');
      const h3 = document.createElement('h3');
      h3.textContent = label;
      heading.append(h3);
      list.append(heading);
      for (const hit of group) {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = hit.url;
        const title = document.createElement('span');
        title.className = 'hit-title';
        title.textContent = hit.meta.title ?? hit.url;
        link.append(title);
        if (hit.meta.summary) {
          const summary = document.createElement('span');
          summary.className = 'hit-summary';
          summary.textContent = hit.meta.summary;
          link.append(summary);
        }
        item.append(link);
        list.append(item);
      }
    }
  }

  async function run() {
    if (!input || !list || !status || !clear) return;
    const query = input.value.trim();
    clear.hidden = !query;
    const url = new URL(location.href);
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    if (!query) {
      list.replaceChildren();
      status.textContent = '';
      return;
    }
    const pagefind = await load();
    if (!pagefind) {
      status.textContent = 'Search works on the built site. Browse below, or use the A–Z.';
      return;
    }
    const search = await pagefind.debouncedSearch(query, {}, 180);
    if (search === null) return; // a newer keystroke took over
    const hits = await Promise.all(search.results.slice(0, 40).map((r) => r.data()));
    render(hits, search.results.length, query);
  }

  // Quick compare: build the table URL with its filters as URL state.
  const quick = document.querySelector('[data-quick]');
  if (quick) {
    quick.hidden = false;
    const choices = JSON.parse(quick.dataset.quickChoices);
    const compoundSel = quick.querySelector('[data-q-compound]');
    const classSel = quick.querySelector('[data-q-class]');
    const doseInput = quick.querySelector('[data-q-dose]');
    const unit = quick.querySelector('[data-q-unit]');
    const fill = () => {
      const c = choices.find((x) => x.id === compoundSel.value);
      classSel.replaceChildren();
      if (!c) { unit.textContent = ''; doseInput.value = ''; return; }
      for (const k of c.classes) {
        const o = document.createElement('option');
        o.value = k.slug; o.textContent = k.label; o.dataset.dose = k.dose;
        classSel.append(o);
      }
      unit.textContent = c.unit;
      doseInput.value = classSel.selectedOptions[0]?.dataset.dose ?? '';
    };
    compoundSel.addEventListener('change', fill);
    classSel.addEventListener('change', () => { doseInput.value = classSel.selectedOptions[0]?.dataset.dose ?? ''; });
    quick.addEventListener('submit', (event) => {
      event.preventDefault();
      const c = choices.find((x) => x.id === compoundSel.value);
      if (!c) { compoundSel.focus(); return; }
      const cls = classSel.value || c.classes[0].slug;
      const params = new URLSearchParams();
      const standard = Number(classSel.selectedOptions[0]?.dataset.dose);
      if (Number(doseInput.value) > 0 && Number(doseInput.value) !== standard) params.set('dose', doseInput.value);
      const per = quick.querySelector('[data-per]').value;
      if (per !== 'dose') params.set('per', per);
      const boxes = [...quick.querySelectorAll('[data-q-retailer]')];
      if (!boxes.every((b) => b.checked)) params.set('r', boxes.filter((b) => b.checked).map((b) => b.value).join(','));
      if (quick.querySelector('[data-q-intl]').checked) params.set('intl', '1');
      if (quick.querySelector('[data-q-stock]').checked) params.set('stock', '1');
      const q = params.toString();
      location.href = `/c/${c.slug}/${cls}/${q ? `?${q}` : ''}`;
    });
  }

  if (form && input) {
    input.addEventListener('input', run);
    form.addEventListener('submit', (event) => event.preventDefault());
    form.addEventListener('reset', () => setTimeout(run));
    const initial = new URL(location.href).searchParams.get('q');
    if (initial) {
      input.value = initial;
      run();
    }
  }

  // "Show price" also rescales every card's figures on this page: at one standard dose a day,
  // per week = 7 doses, per month = 30, per year = 365 (the tables use the same rule).
  const perSelect = document.querySelector('[data-per]');
  const PERIODS = { week: [7, 'Per week'], month: [30, 'Per month'], year: [365, 'Per year'] };
  const pounds = (v) => `£${v.toFixed(2)}`;
  const perDoseText = (v) => `£${v.toFixed(Math.min(4, Math.max(2, 2 - Math.floor(Math.log10(v)))))}`;
  function rescaleCards() {
    const period = PERIODS[perSelect?.value];
    for (const row of document.querySelectorAll('.compound-card [data-row]')) {
      const dose = Number(row.dataset.ppu) * Number(row.dataset.std);
      const main = row.querySelector('[data-cell="dose"]');
      const second = row.querySelector('[data-cell="month"]');
      main.dataset.doseLabel ??= main.dataset.label;
      if (period) {
        main.textContent = pounds(dose * period[0]);
        main.dataset.label = period[1];
        second.textContent = period[0] === 30 ? perDoseText(dose) : pounds(dose * 30);
        second.dataset.label = period[0] === 30 ? main.dataset.doseLabel : 'Per month';
      } else {
        main.textContent = perDoseText(dose);
        main.dataset.label = main.dataset.doseLabel;
        second.textContent = pounds(dose * 30);
        second.dataset.label = 'Per month';
      }
    }
    // The other forms' "from" prices follow the same switch.
    for (const el of document.querySelectorAll('.compound-card [data-form-price]')) {
      const dose = Number(el.dataset.formPrice);
      el.textContent = period ? `${pounds(dose * period[0])} ${period[1].toLowerCase()}` : perDoseText(dose);
    }
  }
  perSelect?.addEventListener('change', rescaleCards);
</script>
