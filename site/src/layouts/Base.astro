---
import '@fontsource-variable/red-hat-display';
import '@fontsource-variable/red-hat-text';
import '@fontsource-variable/red-hat-mono';
import '../styles/tokens.css';
import '../styles/global.css';
import { CATEGORY_LABELS, compounds, meta } from '../lib/data';
import { isoToLong } from '../lib/format';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Path of a share image, e.g. /og/magnesium/bisglycinate.png */
  image?: string;
  noindex?: boolean;
  /** schema.org JSON-LD for this page */
  jsonLd?: object;
  /** Extra text for the search index only (aliases, brief §13) */
  searchTerms?: string[];
  /** Relative importance in search results; product pages rank below compound pages. */
  searchWeight?: number;
  /** Shown in search results: what kind of page this is, and a one-line factual summary. */
  searchKind?: 'Compare' | 'Product' | 'Guide';
  searchSummary?: string;
}

const { title, description = site.tagline, image, noindex = false, jsonLd, searchTerms = [], searchWeight, searchKind = 'Guide', searchSummary = description } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = site.base_url ? new URL(Astro.url.pathname, site.base_url).href : undefined;
const imageUrl = image && site.base_url ? new URL(image, site.base_url).href : image;

const path = Astro.url.pathname;
const isHome = path === '/';
const NAV = [
  { href: '/#search', label: 'Search', search: true },
  { href: '/combinations/', label: 'Combinations' },
  { href: '/basket/', label: 'Build a basket' },
  { href: '/a-z/', label: 'A–Z' },
  { href: '/methodology/', label: 'How we compare' },
  { href: '/about/', label: 'About' },
];
const categories = Object.keys(CATEGORY_LABELS).filter((id) => compounds.some((d) => d.compound.category === id));
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <script is:inline>try{if(localStorage.getItem("theme")==="dark")document.documentElement.dataset.theme="dark"}catch(e){}</script>
    <!-- Impact.com site-ownership check (an identifier only; no script, no requests). -->
    <meta name="impact-site-verification" content="b6cad2ff-e231-40ab-ad47-03b66249976d" />
    <!-- Impact-Site-Verification: b6cad2ff-e231-40ab-ad47-03b66249976d -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:card" content="summary_large_image" />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <p class="disclosure">
      <span class="wrap" style="display:block">
        <span class:list={{ 'wide-only': Boolean(site.disclosure_short) }}>{site.disclosure}</span>
        {site.disclosure_short && <span class="narrow-only">{site.disclosure_short}</span>}{' '}
        <a href="/disclosure/">Full disclosure</a>.
      </span>
    </p>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="site-name"><span class="capsule" aria-hidden="true"></span>{site.name.toLowerCase()}</a>
        <nav aria-label="Main">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                class:list={{ 'nav-search': item.search }}
                aria-current={!item.search && path.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="header-end">
          {
            !isHome && (
              <form class="header-search" action="/" method="get" role="search">
                <label class="sr-only" for="header-q">Search supplements and products</label>
                <input id="header-q" type="search" name="q" placeholder="Search supplements" autocomplete="off" />
              </form>
            )
          }
          <span class="updated">Updated {isoToLong(meta.generated_at)}</span>
        </div>
      </div>
    </header>
    <main id="main" class="wrap" data-pagefind-body={noindex ? undefined : true} data-pagefind-weight={searchWeight}>
      <span hidden data-pagefind-meta="kind[data-v]" data-v={searchKind}></span>
      <span hidden data-pagefind-meta="summary[data-v]" data-v={searchSummary}></span>
      <slot />
      {searchTerms.length > 0 && <p class="sr-only" data-pagefind-weight="10">Also known as: {searchTerms.join(', ')}.</p>}
    </main>
    <footer class="site-footer">
      <span hidden>Impact-Site-Verification: b6cad2ff-e231-40ab-ad47-03b66249976d</span>
      <div class="wrap footer-grid">
        <div class="footer-about">
          <a href="/" class="site-name"><span class="capsule" aria-hidden="true"></span>{site.name.toLowerCase()}</a>
          <p>{site.tagline}.</p>
          <p>
            Not medical advice. We compare prices of supplements people have already decided to buy; we do not recommend
            what to take. If you are under 18, pregnant, take medication or have a health condition, speak to a pharmacist
            or GP.
          </p>
          {site.amazon_tag && <p class="small">As an Amazon Associate, {site.name} earns from qualifying purchases.</p>}
          <p><button type="button" class="button-plain theme-toggle" data-theme-toggle>Switch to dark mode</button></p>
          <script is:inline>(function(){var b=document.querySelector('[data-theme-toggle]');if(!b)return;var set=function(){b.textContent=document.documentElement.dataset.theme==='dark'?'Switch to light mode':'Switch to dark mode'};set();b.addEventListener('click',function(){var dark=document.documentElement.dataset.theme!=='dark';if(dark)document.documentElement.dataset.theme='dark';else delete document.documentElement.dataset.theme;try{localStorage.setItem('theme',dark?'dark':'light')}catch(e){}set()})})();</script>
        </div>
        <nav aria-label="Compare prices" class="footer-links">
          <h2>Compare</h2>
          <a href="/a-z/">A–Z of supplements</a>
          {categories.map((id) => <a href={`/browse/${id}/`}>{CATEGORY_LABELS[id]}</a>)}
          <a href="/combinations/">Combinations</a>
          <a href="/basket/">Build a basket</a>
        </nav>
        <nav aria-label="About this site" class="footer-links">
          <h2>This site</h2>
          <a href="/methodology/">How we compare</a>
          <a href="/disclosure/">Affiliate disclosure</a>
          <a href="/about/">About</a>
          {site.contact_email && <a href={`mailto:${site.contact_email}`}>Contact us</a>}
        </nav>
      </div>
    </footer>
  </body>
</html>
