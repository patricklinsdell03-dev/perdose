// Cloudflare deploy settings. Patrick's Cloudflare project is a Worker serving static files
// (DECISIONS.md 2026-09-17). Self-contained: the build runs here, so the dashboard's build
// command can be left blank; its deploy command stays `npx wrangler deploy`.
// "name" must match the project name in the Cloudflare dashboard.
{
  "name": "perdose",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "npm --prefix site ci && npm --prefix site run build"
  },
  "assets": {
    "directory": "./site/dist",
    "not_found_handling": "404-page"
  }
}
