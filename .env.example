# Copy this file to .env and fill in the values. NEVER commit .env.
# Names only — no real keys belong in this file.

# LLM (Phase 2)
ANTHROPIC_API_KEY=

# Awin — one feed download link per retailer: AWIN_FEED_URL_<RETAILER_ID_IN_CAPS>=https://...
# (the link contains your API key: treat it like a password)
AWIN_API_KEY=

# Impact (Phase 6)
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=

# Set to 1 to run the golden set against the live LLM instead of the replay cache
PERDOSE_LIVE_LLM=
