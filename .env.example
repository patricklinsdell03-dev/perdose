# Copy this file to .env and fill in the values. NEVER commit .env.
# Names only — no real keys belong in this file.

# LLM (Phase 2)
ANTHROPIC_API_KEY=

# Awin — the Create-a-Feed download link covering all your advertisers (the link contains
# your API key: treat it like a password). Retailers are split by advertiser id in
# config/retailers.yml. A retailer can instead have its own link: AWIN_FEED_URL_<ID_IN_CAPS>.
AWIN_FEED_URL=

# Impact (Phase 6)
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=

# Set to 1 to run the golden set against the live LLM instead of the replay cache
PERDOSE_LIVE_LLM=

# Amazon Product Advertising API (brief v1.8) — from Patrick's Associates account once it has 3 sales
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
